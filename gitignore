.vscode/*
!.vscode/extensions.json
.idea
*.swp

# Just in case -- the real one lives in web/.gitignore, but this is a
# safety net if npm ever gets run somewhere it shouldn't (like api/).
# NOT ignoring package-lock.json here on purpose: web/package-lock.json
# is a real lockfile you want committed (it pins your frontend's exact
# dependency versions). Only the stray one in api/ was the problem, and
# that gets removed by hand (git rm), not silenced by this file.
node_modules/
